# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/interncatalyst

# SQL Database Configuration (PostgreSQL / MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interncatalyst_db
DB_USER=root
DB_PASSWORD=your_password_here

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
OTP_EXPIRY_MINUTES=10

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Admin Initial Credentials Setup
ADMIN1_PASSWORD=your_admin1_password
ADMIN2_PASSWORD=your_admin2_password
ADMIN3_PASSWORD=your_admin3_password
ADMIN_DEFAULT_PASSWORD=your_default_admin_password

# Email / SMTP Service Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM=InternCatalyst <no-reply@interncatalyst.org>
